# Aurora-MD Environment Configuration
# Made with ❤ by AlienAlfa

# ========================================
# DATABASE CONFIGURATION
# ========================================

# Set to true to use MongoDB instead of SQLite/PostgreSQL
USE_MONGODB=false

# MongoDB Connection URI
# Format: mongodb://username:password@host:port/database
# For MongoDB Atlas: mongodb+srv://username:password@cluster.mongodb.net/database
# For local MongoDB: mongodb://localhost:27017/aurora_db
MONGODB_URI=

# Alternative name for MongoDB URI (some services use this)
MONGO_URI=

# Traditional SQL Database URL (used when USE_MONGODB=false)
# For SQLite: ./assets/database.db
# For PostgreSQL: postgres://username:password@host:port/database
DATABASE_URL=./assets/database.db

# ========================================
# BOT CONFIGURATION
# ========================================

# Bot session ID (get from WhatsApp Web scan)
SESSION_ID=

# Bot work type: private, public, or groups
WORK_TYPE=private

# Command handlers (prefix for commands)
HANDLER=^

# Bot owner's phone number (with country code, no + sign)
SUDO=0

# Bot name and owner name
BOT_NAME=𝗔𝗨𝗥𝗢𝗥𝗔
OWNER_NAME=𝞓𝙇𝞘𝞢𝞜-𝞓𝙇𝙁𝞓

# ========================================
# FEATURES CONFIGURATION
# ========================================

# Enable/disable automatic message reading
AUTO_READ=false

# Enable/disable automatic status reading
AUTO_STATUS_READ=false

# Enable/disable bot logs
LOGS=true

# Anti-link protection
ANTI_LINK=false
ANTILINK_ACTION=kick

# Warning system
WARN_COUNT=3

# Welcome and goodbye messages
WELCOME_MSG=Hi @user Welcome to @gname
GOODBYE_MSG=@user Left The Group

# ========================================
# API KEYS AND SERVICES
# ========================================

# Google Gemini AI API Key
GEMINI_API=

# Remove.bg API Key for background removal
RMBG_KEY=

# OpenAI API Key for ChatGPT features
OPENAI_API_KEY=

# ========================================
# HEROKU DEPLOYMENT (Optional)
# ========================================

# Heroku app name
HEROKU_APP_NAME=

# Heroku API key
HEROKU_API_KEY=

# Set to true if deploying on Heroku
HEROKU=false

# Git URL for external plugins
HEROKU_GIT_URL=

# ========================================
# STICKER CONFIGURATION
# ========================================

# Sticker pack name and author
PACKNAME=𝞓𝙇𝞘𝞢𝞜
AUTHOR=𝞓𝙇𝙁𝞓

# ========================================
# ADVANCED CONFIGURATION
# ========================================

# Language setting
LANG=EN

# Authentication token (if required)
AUTH_TOKEN=

# Session URL (alternative to SESSION_ID)
SESSION_URL=

# Deleted message logging
DELETED_LOG=false
DELETED_LOG_CHAT=

# Branch for updates
BRANCH=master
